# Copy to .env (gitignored) and fill in. Load it with Node's built-in loader:
#   node --env-file=.env src/server.js
#   node --env-file=.env --test test/orchestrator/openai-live.test.js

# --- Model provider --------------------------------------------------------
# OpenAI directly: set OPENAI_API_KEY and leave OPENAI_BASE_URL unset.
# OpenRouter: use your OpenRouter key and its base URL below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Required: chat model for the Supervisor and the Sub-agents.
# On OpenRouter prefer an OpenAI model (strict JSON schema + tool calling), e.g. openai/gpt-4.1
OPENAI_MODEL=openai/gpt-4.1

# Optional: cheaper model for Intent classification; falls back to OPENAI_MODEL.
OPENAI_ROUTER_MODEL=openai/gpt-4.1-mini

# --- Server ----------------------------------------------------------------
# PORT=3000

# Landlord store: the SQLite file for landlords and their Listings (default data/landlord.sqlite, gitignored).
# LANDLORD_DB_PATH=data/landlord.sqlite

# Applicant pool: the directory of applicant files (default data/applicants) and the day it is read
# as of (default 2026-09-28, the day the committed pool was generated, so it does not expire).
# APPLICANT_POOL_DIR=data/applicants
# APPLICANT_POOL_TODAY=2026-09-28

# --- Tracing ---------------------------------------------------------------
# LangSmith traces contain full lease contents. Keep tracing OFF with real leases.
LANGSMITH_TRACING=false
